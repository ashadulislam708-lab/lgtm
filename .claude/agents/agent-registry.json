      "canDelegate": ["code-architecture-reviewer", "refactor-agent", "plan-reviewer", "auto-error-resolver", "agent-monitor", "gap-finder"],
      "canBeCalledBy": ["project-coordinator", "ticket-fixer", "backend-developer", "frontend-developer"]
