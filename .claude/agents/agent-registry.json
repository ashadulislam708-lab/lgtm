{
  "version": "2.0",
  "description": "Central registry mapping agents to their framework resources and team structure",
  "teams": {
    "team-backend": {
      "name": "Backend Engineering Team",
      "description": "Server-side development: APIs, database, business logic, migrations",
      "leader": "backend-developer",
      "members": ["nestjs-specialist", "django-specialist", "database-designer"],
      "color": "green",
      "domain": ["api-endpoints", "database", "business-logic", "migrations", "backend-architecture"]
    },
    "team-frontend": {
      "name": "Frontend & Mobile Team",
      "description": "Client-side development: React web, React Native mobile, UI components",
      "leader": "frontend-developer",
      "members": ["mobile-developer", "api-integration-agent"],
      "color": "blue",
      "domain": ["ui-components", "routing", "state-management", "html-conversion", "mobile-features"]
    },
    "team-quality": {
      "name": "Quality & Architecture Team",
      "description": "Code review, refactoring, error resolution, plan validation, monitoring",
      "leader": "quality-lead",
      "members": ["code-architecture-reviewer", "refactor-agent", "plan-reviewer", "auto-error-resolver", "agent-monitor", "gap-finder"],
      "color": "purple",
      "domain": ["code-review", "refactoring", "error-resolution", "plan-validation", "architecture-assessment", "monitoring"]
    },
    "team-docs": {
      "name": "Documentation & Research Team",
      "description": "Documentation creation, PRD conversion, technical research",
      "leader": "documentation-architect",
      "members": ["web-research-specialist", "prd-converter"],
      "color": "yellow",
      "domain": ["documentation", "prd-conversion", "research", "api-docs", "design-system-docs"]
    }
  },
  "coordinator": {
    "agent": "project-coordinator",
    "description": "Top-level orchestrator for multi-team workflows",
    "manages": ["team-backend", "team-frontend", "team-quality", "team-docs"],
    "crossTeamAgents": ["ticket-fixer"]
  },
  "agentTypes": {
    "backend": {
      "description": "Backend development agents",
      "frameworks": ["nestjs", "django"],
      "color": "green",
      "defaultModel": "opus"
    },
    "frontend": {
      "description": "Frontend web development agents",
      "frameworks": ["react"],
      "color": "blue",
      "defaultModel": "opus"
    },
    "mobile": {
      "description": "Mobile development agents",
      "frameworks": ["react-native"],
      "color": "cyan",
      "defaultModel": "opus"
    },
    "cross-stack": {
      "description": "Full-stack agents working across multiple frameworks",
      "frameworks": ["nestjs", "react"],
      "color": "green",
      "defaultModel": "opus"
    },
    "generic": {
      "description": "Framework-agnostic agents",
      "frameworks": [],
      "color": "blue",
      "defaultModel": "sonnet"
    }
  },
  "agents": {
    "project-coordinator": {
      "type": "generic",
      "description": "Top-level orchestrator for multi-team project work",
      "frameworkOverrides": null,
      "team": null,
      "role": "coordinator",
      "canDelegate": ["backend-developer", "frontend-developer", "quality-lead", "documentation-architect", "ticket-fixer"],
      "canBeCalledBy": ["user"]
    },
    "backend-developer": {
      "type": "backend",
      "description": "NestJS/Django backend implementation",
      "frameworkOverrides": null,
      "team": "team-backend",
      "role": "leader",
      "canDelegate": ["nestjs-specialist", "django-specialist", "database-designer"],
      "canBeCalledBy": ["project-coordinator", "ticket-fixer", "api-integration-agent", "prd-converter"]
    },
    "nestjs-specialist": {
      "type": "backend",
      "description": "Advanced NestJS architecture and optimization",
      "frameworkOverrides": ["nestjs"],
      "team": "team-backend",
      "role": "member",
      "canDelegate": [],
      "canBeCalledBy": ["backend-developer"]
    },
    "django-specialist": {
      "type": "backend",
      "description": "Advanced Django REST Framework patterns",
      "frameworkOverrides": ["django"],
      "team": "team-backend",
      "role": "member",
      "canDelegate": [],
      "canBeCalledBy": ["backend-developer"]
    },
    "database-designer": {
      "type": "backend",
      "description": "Database schema design and migrations",
      "frameworkOverrides": null,
      "team": "team-backend",
      "role": "member",
      "canDelegate": [],
      "canBeCalledBy": ["backend-developer", "project-coordinator", "ticket-fixer"]
    },
    "frontend-developer": {
      "type": "frontend",
      "description": "React web development",
      "frameworkOverrides": null,
      "team": "team-frontend",
      "role": "leader",
      "canDelegate": ["mobile-developer", "api-integration-agent"],
      "canBeCalledBy": ["project-coordinator", "ticket-fixer", "api-integration-agent", "prd-converter"]
    },
    "mobile-developer": {
      "type": "mobile",
      "description": "React Native mobile development",
      "frameworkOverrides": null,
      "team": "team-frontend",
      "role": "member",
      "canDelegate": [],
      "canBeCalledBy": ["frontend-developer"]
