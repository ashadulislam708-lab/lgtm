{
  "version": "1.0",
  "description": "Skill triggers - project-specific skills only",
  "skills": {
    "skill-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "file": "skill-developer/SKILL.md",
      "promptTriggers": {
        "keywords": ["create skill", "new skill", "skill development", "skill-rules", "build skill"],
        "intentPatterns": [
          "(create|build|add|develop).*skill",
          "skill.*?(template|structure|format)"
        ]
      }
    },
    "generate-ppt": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "promptTriggers": {
        "keywords": ["presentation", "ppt", "powerpoint", "slides", "reveal.js", "townhall", "deck", "generate-ppt"],
        "intentPatterns": [
          "(create|generate|build|make).*?(presentation|slides|deck|ppt)",
          "(html|reveal).*?presentation",
          "brand.*?(presentation|slides)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "presentations/**/*.html",
          "presentations/**/*.md",
          ".claude/**/reveal*.html"
        ]
      }
    },
