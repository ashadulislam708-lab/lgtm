    "setup-claude": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "promptTriggers": {
        "keywords": [
          "setup claude",
          "add framework",
          "framework submodules",
          "configure frameworks",
          "add django",
          "add nestjs",
          "add react",
          "add react native",
          "add marketing",
          "add operations",
          "framework configuration",
          "department configuration"
        ],
        "intentPatterns": [
          "(setup|add|configure|install).*?(framework|claude|submodule|department)",
          "(add|setup).*?(django|nestjs|react|react.?native|marketing|operations)",
          "(framework|department).*?(setup|configuration|submodule)"
        ]
      },
      "commands": [
        "setup-claude"
      ]
    },
    "type-organization": {
      "type": "guardrail",
      "enforcement": "warn",
      "priority": "high",
      "promptTriggers": {
        "keywords": ["interface", "type", "types", "extract types", "inline interface", "type organization", "type assertion", "as {}", "inline cast", "inline type assertion"],
        "intentPatterns": [
          "(create|add|define).*?(interface|type).*?(component|page|util|hook)",
          "inline.*?(interface|type)",
          "(move|extract).*?(interface|type).*?types",
          "(fix|remove|extract).*?(inline|assertion).*?type"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "*/app/components/**/*.tsx",
          "*/app/pages/**/*.tsx",
          "*/app/utils/**/*.ts",
          "*/app/hooks/**/*.ts",
          "*/app/redux/**/*.ts",
          "*/app/services/**/*.ts"
        ],
        "pathExclusions": ["*/app/types/**"],
        "contentPatterns": ["^(export )?interface ", "^(export )?type ", "as \\{[^}]+\\}", "\\(data:\\s*\\{[^}]+\\}"]
      },
      "blockMessage": "All interfaces and types must be defined in `types/*.d.ts` files, not inline in {file_path}. Inline type assertions (`as { ... }`) and callback parameter types (`(data: { ... })`) should use named types from type files. Extract to the appropriate domain type file."
    },
    "mutation-thunk-guardrail": {
      "type": "guardrail",
      "enforcement": "warn",
      "priority": "high",
      "promptTriggers": {
        "keywords": ["createAsyncThunk", "create thunk", "mutation thunk", "async thunk create", "async thunk update", "async thunk delete"],
        "intentPatterns": [
          "createAsyncThunk.*?(create|update|delete|remove|add|edit|reset|archive)",
          "(create|add).*?thunk.*?(mutation|create|update|delete)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "*/app/services/httpServices/*Service.ts"
        ],
        "contentPatterns": [
          "createAsyncThunk.*?(create|update|delete|remove|add|edit|reset|archive)"
        ]
      },
      "blockMessage": "createAsyncThunk should ONLY be used for READ/FETCH operations. For mutations (create/update/delete), use direct service calls with FormHandleState pattern. See .claude/react/guides/crud-operations.md for the correct pattern."
    },
    "gap-finder": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "file": "gap-finder/SKILL.md",
      "promptTriggers": {
        "keywords": ["gap finder", "gap analysis", "missing design", "missing icons", "design audit", "implementation gaps", "compliance check"],
        "intentPatterns": [
          "(find|check|scan|audit).*?(gaps|missing|incomplete)",
          "(design|icon|implementation).*?(audit|check|review|gaps)",
