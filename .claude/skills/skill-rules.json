    },
    "modal-submitting-guardrail": {
      "type": "guardrail",
      "enforcement": "warn",
      "priority": "high",
      "fileTriggers": {
        "pathPatterns": [
          "*/app/components/**/*Modal*.tsx",
          "*/app/components/**/*Dialog*.tsx"
        ],
        "contentPatterns": [
          "useState.*(submitting|isSubmitting|setSubmitting)"
        ]
      },
      "blockMessage": "Modals MUST NOT have their own submitting/isSubmitting state. Pass loading as a prop from the parent's FormHandleState. See .claude/react/guides/crud-operations.md"
    },
