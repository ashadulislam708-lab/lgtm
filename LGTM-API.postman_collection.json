							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.data) {",
									"    if (res.data.accessToken) pm.collectionVariables.set('accessToken', res.data.accessToken);",
									"    if (res.data.refreshToken) pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
									"    if (res.data.user && res.data.user.id) pm.collectionVariables.set('userId', res.data.user.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\",\n  \"rememberMe\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
